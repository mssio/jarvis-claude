{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(bash scripts/sync.sh *)",
      "Bash(bash scripts/spending.sh *)",
      "Bash(date *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git commit *--amend*)",
      "Bash(git filter-branch *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/sync.sh\" --auto",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
